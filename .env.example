# Opcional: chave da brapi.dev para dados B3 mais ricos
# BRAPI_TOKEN=

# Capital inicial do paper trading (BRL)
# PAPER_INITIAL_CASH=100000

# Opcional: chave da xAI para o coach com IA (sem ela usa texto local)
# XAI_API_KEY=
# XAI_MODEL=

# Internacionalização leve: "pt_BR" (padrão) ou "en_US"
# LOCALE=pt_BR

# Regime macro: "auto" | "expansionary" | "cautious" | "restrictive" | "off"
# MACRO_OVERRIDE=off
